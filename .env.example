# ============================================================
#  Paper Extractor 环境变量配置（仅 Docker 部署需要）
#  本地运行只需 config.yaml，不需要此文件
#
#  复制为 .env 并填入实际值
# ============================================================

# ── 数据库（必填） ──
DB_HOST=your_postgresql_host
DB_PASSWORD=your_db_password
DB_PORT=5432

# ── LLM API Keys（每个实例一个，用于并行处理） ──
LLM_API_KEY_1=your_llm_key_1
LLM_API_KEY_2=your_llm_key_2
LLM_API_KEY_3=your_llm_key_3

# ── MinerU + Semantic Scholar API Keys（共用同一个 Key，每实例一个） ──
MINERU_API_KEY_1=your_platform_key_1
MINERU_API_KEY_2=your_platform_key_2
MINERU_API_KEY_3=your_platform_key_3

# ── 服务地址（可选，不填则用 config.yaml 中的值） ──
# LLM_BASE_URL=http://your_llm_host/v1
# MINERU_BASE_URL=http://your_platform_host

# ── 天地图（可选，通过 config.yaml 或此处配置） ──
# TIANDITU_TK=your_tianditu_tk

# ── 百度地图（可选） ──
# BAIDU_API_KEY=your_baidu_key

# ── 端口映射（可选，默认 8001/8002/8003） ──
# PORT_1=8001
# PORT_2=8002
# PORT_3=8003
