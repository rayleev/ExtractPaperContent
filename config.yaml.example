# ============================================================
#  paper_extractor 配置文件（示例）
#  复制为 config.yaml 并填入实际值
#
#  敏感值（API Key、密码）支持环境变量覆盖：
#    LLM_API_KEY, MINERU_API_KEY, SS_API_KEY, DB_PASSWORD
#    TIANDITU_TK, BAIDU_API_KEY
#  环境变量优先级高于 config.yaml
# ============================================================

# 路径配置
paths:
  base_dir: "."                    # 项目根目录（Docker 中为 /app）
  papers_dir: "docs"               # 论文数据目录（PDF/MD 直接放此目录下）
  cache_dir: "cache"               # 运行缓存（共享，支持断点续跑）
  parsed_dir: "output/parsed"      # MinerU 解析后的 markdown（共享）
  runs_dir: "output/runs"          # 每次运行的输出目录: runs/{时间戳}/

# MinerU PDF 解析服务（必填）
mineru:
  base_url: "http://YOUR_MINERU_HOST"
  api_key: ""                      # 或通过环境变量 MINERU_API_KEY 设置
  lang_list: ["ch", "en"]
  poll_interval: 5
  poll_timeout: 600
  return_md: true
  return_content_list: false
  return_middle_json: false
  formula_enable: true
  table_enable: true
  parse_method: "ocr"              # auto / txt / ocr

# LLM 服务（必填）
llm:
  base_url: "http://YOUR_LLM_HOST/v1"
  api_key: ""                      # 或通过环境变量 LLM_API_KEY 设置
  model: "glm-52"
  max_tokens: 16384                # 默认输出上限（token）
  temperature: 0.1
  max_retries: 5
  timeout: 1800                    # 请求超时时间（秒）— parse/extract 大论文需要更长
  classify_max_tokens: 1000        # 分类节点输出上限
  evidence_max_tokens: 2000        # 证据验证节点输出上限
  validate_max_tokens: 200         # 规则验证节点输出上限
  # 深度思考（thinking）配置 — 仅 GLM-5 等支持 thinking 的模型生效
  # 使用 chat_template_kwargs 格式（CC映射代理只接受此格式）
  thinking: {"enable_thinking": false}  # 全局关闭深度思考
  thinking_overrides:               # 节点级覆盖（优先级高于全局）
    parse: {"enable_thinking": false}  # parse 节点关闭
    extract_phase2: {"enable_thinking": false}  # 品种提取节点关闭

# 提取参数
extraction:
  max_text_chars: 120000
  extractable_categories:
    - "varietal_yield"
    - "management_yield"
  confidence_threshold: 0.5
  crops:                           # 目标作物列表
    - "水稻/Rice"
  search_keywords:                 # 搜索关键词列表
    - "水稻产量"
    - "rice yield"
  search_year_range: ""            # 年份范围过滤，如 "2020-2025"，空则不限

# 地理编码
geocoding:
  enabled: true
  use_tianditu: true               # 是否启用天地图（国内服务，推荐）
  tianditu_tk: ""                  # 或通过环境变量 TIANDITU_TK 设置
  tianditu_delay: 0.2              # 天地图请求间隔（秒）
  baidu_api_key: ""                # 或通过环境变量 BAIDU_API_KEY 设置
  # 地理编码服务地址（可选覆盖，默认使用公共服务）
  # tianditu_url: "https://api.tianditu.gov.cn/geocoder"
  # baidu_url: "https://api.map.baidu.com/geocoding/v3/"
  # elevation_url: "https://api.open-meteo.com/v1/elevation"

# 全文理解（parse 节点）
parse:
  context_window: 1000000          # LLM 上下文窗口大小（token），1M 模型设为 1000000
  full_text_threshold: 0.5         # 论文 token < context_window * 此值 → 一次性给全文
  chunked_enabled: true            # 长论文 + 有章节标题 → 分段理解
  sliding_window_enabled: true     # 长论文 + 无章节标题 → 滑动窗口
  sliding_window_size: 50000       # 滑动窗口大小（字符），中文约 33000 tokens
  sliding_window_step: 40000       # 滑动窗口步长（字符）

# 并发控制
concurrency:
  extract_workers: 2                       # 并发论文数（同时跑的论文数）

# PostgreSQL 数据库（必填）
database:
  host: ""                         # 或通过环境变量 DB_HOST 设置
  port: 5432
  dbname: "paper_extractor"
  user: "postgres"
  password: ""                     # 或通过环境变量 DB_PASSWORD 设置

# Semantic Scholar 代理 API（论文搜索 + PDF 下载）
# 与 MinerU 共用同一服务和 API Key，无需单独配置
# 如需覆盖，可取消注释并显式设置：
# semantic_scholar:
#   base_url: "http://other_host"
#   api_key: "other_key"
#   max_retries: 5
#   request_interval: 0.3

# 日志配置
logging:
  level: "INFO"
  format: "%(asctime)s [%(levelname)s] %(message)s"

# 证据验证配置
evidence_validation:
  enabled: true
  fields:
    - field: crop_species
      required: true
    - field: variety_name
      required: true
    - field: yield_raw_value
      required: true
    - field: n_raw_value
      required: false
    - field: p_raw_value
      required: false
    - field: k_raw_value
      required: false
